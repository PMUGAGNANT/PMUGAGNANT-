# Client Supabase public
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Client Supabase admin
# Requis pour les cron jobs, l'apprentissage et les rapports.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protection optionnelle des routes cron
CRON_SECRET=your-shared-cron-secret

# Alertes Telegram optionnelles
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Abonnement Stripe
# En production Vercel, utiliser l'URL publique du déploiement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exemple de production : https://pmugagnant-git-main-pmugagnants-projects.vercel.app
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Emails de confirmation d'abonnement via Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=PMU AI <no-reply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# --- Références de déploiement (pas de secrets) ---
# Dépôt GitHub : https://github.com/PMUGAGNANT/PMUGAGNANT-
# App Vercel : https://pmugagnant-git-main-pmugagnants-projects.vercel.app
# Console Supabase (org / projet) : https://supabase.com/dashboard
