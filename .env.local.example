# Public Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase admin client (required for cron jobs, learning, reports)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional manual protection for cron routes
CRON_SECRET=your-shared-cron-secret

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Stripe subscription billing (production Vercel : utiliser l'URL publique du deploiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exemple production : https://pmugagnant-git-main-pmugagnants-projects.vercel.app
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Optional subscription confirmation emails via Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=PMU AI <no-reply@your-domain.com>

# --- References deploiement (pas de secrets) ---
# Dep GitHub : https://github.com/PMUGAGNANT/PMUGAGNANT-
# App Vercel : https://pmugagnant-git-main-pmugagnants-projects.vercel.app
# Console Supabase (org / projet) : https://supabase.com/dashboard
