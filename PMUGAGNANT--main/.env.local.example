# Client Supabase public
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Client Supabase admin
# Requis pour les cron jobs, l'apprentissage et les rapports.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protection des routes cron. Utiliser lettres/chiffres pour eviter les soucis d'URL.
CRON_SECRET=TurfEdge2026PMUSecret123

# Alertes Telegram optionnelles
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Abonnement Stripe
# Local: http://localhost:3000
# Production Vercel: https://pmugagnant.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local / test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Production Vercel: utiliser uniquement les valeurs live Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_live_xxx
# STRIPE_PRICE_ID=price_live_xxx

# Emails de confirmation d'abonnement via Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=TurfEdge <no-reply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# Coach IA TurfEdge
# Par defaut, le coach reste en mode "supabase" avec reponse de secours basee donnees.
# Pour brancher une API IA compatible OpenAI cote serveur:
# COACH_AI_PROVIDER=openai-compatible
# COACH_AI_API_KEY=votre-cle-secrete
# COACH_AI_BASE_URL=https://votre-api-ia.example/v1
# COACH_AI_MODEL=votre-modele
COACH_AI_PROVIDER=supabase
COACH_AI_API_KEY=
COACH_AI_BASE_URL=
COACH_AI_MODEL=gpt-4.1-mini
COACH_AI_TIMEOUT_MS=18000

# Compatibilite historique OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# References de deploiement (pas de secrets)
# Depot GitHub : https://github.com/PMUGAGNANT/PMUGAGNANT-
# App Vercel : https://pmugagnant.vercel.app
# Console Supabase : https://supabase.com/dashboard
